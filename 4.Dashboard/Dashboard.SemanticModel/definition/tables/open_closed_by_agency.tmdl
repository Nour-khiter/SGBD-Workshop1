	partition open_closed_by_agency = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database("localhost", "nyc311"),
				    public_v_open_closed_by_agency = Source{[Schema="public",Item="v_open_closed_by_agency"]}[Data],
				    AddAgencyLabel = Table.AddColumn(public_v_open_closed_by_agency, "agency_label", each if [agency_code] = "DHS" then [agency_name] & " (partial)" else if [agency_code] = "OTI" then [agency_name] & " (n=5, small)" else if [agency_code] = "DOE" then [agency_name] & " (n=17, small)" else [agency_name], type text)
				in
				    AddAgencyLabel

	annotation PBI_ResultType = Table

