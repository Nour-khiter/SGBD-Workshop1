table resolution_by_type
	lineageTag: 9d5ed795-b842-4516-8b3d-efd05d404b9a

	measure 'Highlight Color resolution_by_type' = IF(MAX(resolution_by_type[median_days]) = CALCULATE(MAX(resolution_by_type[median_days]), ALLSELECTED(resolution_by_type[complaint_type])), "#E8710A", "#B8C4D6")
		formatString: @
		lineageTag: e3825b91-606b-4762-8176-d1247cc92b4b

	column complaint_type
		dataType: string
		lineageTag: 88b99f35-5bea-4472-920d-c55f572b9be0
		summarizeBy: none
		sourceColumn: complaint_type

		annotation SummarizationSetBy = Automatic

	column nb_closed
		dataType: int64
		formatString: 0
		lineageTag: 2240581e-caed-4e43-ba64-2efb5ce1b10f
		summarizeBy: sum
		sourceColumn: nb_closed

		annotation SummarizationSetBy = Automatic

	column median_hours
		dataType: double
		lineageTag: 6d26342f-4177-4542-8fa5-e08697d9b88e
		summarizeBy: sum
		sourceColumn: median_hours

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column median_days
		dataType: double
		formatString: 0.0
		lineageTag: 2657fae0-fbf6-42ba-b202-9e7956a28bd1
		summarizeBy: none
		sourceColumn: median_days

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition resolution_by_type = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database("localhost", "nyc311"),
				    public_v_resolution_by_type = Source{[Schema="public",Item="v_resolution_by_type"]}[Data],
				    FilteredForDashboard = Table.SelectRows(public_v_resolution_by_type, each [nb_closed] >= 30 and [median_days] <= 365)
				in
				    FilteredForDashboard

	annotation PBI_ResultType = Table

