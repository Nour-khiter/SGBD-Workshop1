{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.14.0/schema.json",
  "name": "borough_map",
  "position": {
    "x": 30,
    "y": 170,
    "z": 0,
    "width": 900,
    "height": 420,
    "tabOrder": 200
  },
  "visual": {
    "visualType": "azureMap",
    "query": {
      "queryState": {
        "X": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "requests_by_borough"
                    }
                  },
                  "Property": "map_longitude"
                }
              },
              "queryRef": "requests_by_borough.map_longitude"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "requests_by_borough"
                    }
                  },
                  "Property": "map_latitude"
                }
              },
              "queryRef": "requests_by_borough.map_latitude"
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "requests_by_borough"
                    }
                  },
                  "Property": "borough"
                }
              },
              "queryRef": "requests_by_borough.borough",
              "nativeQueryRef": "Borough",
              "active": true
            }
          ]
        },
        "Size": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "requests_by_borough"
                    }
                  },
                  "Property": "Borough Requests"
                }
              },
              "queryRef": "requests_by_borough.Borough Requests",
              "nativeQueryRef": "Requests",
              "active": true
            }
          ]
        }
      }
    },
    "objects": {
      "bubbleLayer": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "sizeByValue": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            }
          }
        }
      ],
      "legend": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Request volume across the five boroughs'"
                }
              }
            }
          }
        }
      ],
      "subTitle": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}
